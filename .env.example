# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — https://dashboard.stripe.com/apikeys (use test keys until launch)
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks — endpoint: /api/checkout/webhook, event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Resend — https://resend.com/api-keys (managed-client order milestone emails)
RESEND_API_KEY=
# Must be a verified sending domain in Resend, or leave unset to use their
# onboarding@resend.dev test address (sandbox-only, can't reach real inboxes).
RESEND_FROM_EMAIL=
